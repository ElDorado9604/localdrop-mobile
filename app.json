{
  "expo": {
    "name": "LocalDrop",
    "slug": "localdrop-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f0f0f"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.eldorado.localdrop",
      "infoPlist": {
        "NSCameraUsageDescription": "Camera is used for offline QR pairing",
        "NSMicrophoneUsageDescription": "Microphone may be used for WebRTC",
        "NSLocalNetworkUsageDescription": "Local network is used for offline file transfer"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f0f0f"
      },
      "package": "com.eldorado.localdrop",
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "ACCESS_WIFI_STATE",
        "CHANGE_WIFI_MULTICAST_STATE",
        "MODIFY_AUDIO_SETTINGS",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "CAMERA",
        "RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-document-picker",
      [
        "./plugins/withWebRTC.js",
        {
          "cameraPermission": "Allow LocalDrop to access your camera for offline pairing",
          "microphonePermission": "Allow LocalDrop to access your microphone"
        }
      ]
    ],
    "scheme": "localdrop",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9b718b88-150f-4760-82f8-8e128690aa4e"
      }
    }
  }
}
